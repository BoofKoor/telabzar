# secrets & local config
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# data / runtime
data/
*.log

# دیتابیسِ محلی/سرریزِ آزمایش — تولید روی Postgres است و هیچ‌چیز فایلِ .db
# نمی‌خواند؛ یک x.db تا امروز کامیت‌شده بود (فاز ۳الف، موردِ ۶).
*.db
*.sqlite
*.sqlite3

# os / editor
.DS_Store
.idea/
.vscode/

# Cloudflare origin cert material (never commit)
certs/*.pem
certs/*.key

# downloader cookie files (throwaway-account sessions — never commit)
cookies/*.txt
cookies/*

# پوشهٔ کوکی‌ها را نگه‌دار ولی محتوایش را نه
!cookies/.gitkeep

# آرتیفکت‌های رندرِ تست (اسکرین‌شات/HTML موقت در ریشه)
/*_page.html
/*_shot.png

# pytest
.pytest_cache/

# ── کنسولِ Next (panel/) ────────────────────────────────────────────────
# سورس کامیت می‌شود، خروجیِ build نه. باندل‌های هش‌دار با هر تغییرِ طراحی
# عوض می‌شوند و دیف را بی‌معنا می‌کنند؛ در تولید مرحلهٔ Node در
# `docker/admin.Dockerfile` می‌سازدشان و در توسعه `npm run export:panel`.
panel/node_modules/
panel/.next/
panel/out/
panel/next-env.d.ts
app/static/console/
