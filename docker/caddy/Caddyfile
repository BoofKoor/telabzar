# درِ ورودیِ HTTPS (سرویسِ `caddy` در docker-compose.yml).
# سرتیفیکیتِ Let's Encrypt را خودش می‌گیرد و خودش تمدید می‌کند؛ هیچ PEMی دستی نیست.
#
# **چه نامی سرتیفیکیت می‌گیرد:** فقط آنچه پنل در `/tls/ask` تأیید کند —
#   • دامنهٔ پنل: `PANEL_DOMAIN` که نصب‌کننده در `.env` می‌نویسد؛
#   • دامنهٔ لینک: کلیدِ `link_domain` در تنظیماتِ پنل (زنده، بدونِ ری‌استارت).
# هر نامِ دیگری handshake را رد می‌کند و **هیچ** درخواستی به Let's Encrypt نمی‌رود؛
# بدونِ این گیت، هر کسی با یک SNIِ دلخواه سهمیهٔ صدورِ ما را می‌سوزاند.
#
# **پیش از بارگذاریِ سرتیفیکیتِ ذخیره‌شده هم همین گیت پرسیده می‌شود** (certmagic،
# `getCertDuringHandshake`، issue #185)؛ پس بعد از ری‌استارتِ Caddy، دامنه‌ای که
# دیگر تأیید نمی‌شود سرو نمی‌شود — عوض‌کردنِ دامنهٔ لینک در پنل، قبلی را از ری‌استارتِ بعدی
# خاموش می‌کند (تا آن موقع از حافظه سرو می‌شود؛ هر دو با Caddy و Pebbleِ واقعی اجرا شد).
#
# **مسیریابی:** میزبانِ پنل → admin؛ هر میزبانِ تأییدشدهٔ دیگر → gateway (`/dl` و `/s`).
# پنل و لینک عمداً روی **دو** میزبانِ جدا می‌مانند: محتوای کاربر هم‌مبدأ با پنل سرو نمی‌شود.
#
# تغییرِ این فایل با `docker compose restart caddy` اعمال می‌شود (Caddy خودش فایل را نمی‌پاید).
{
	on_demand_tls {
		ask http://admin:8080/tls/ask
	}
	# HTTP/3 خاموش: پورتِ UDPِ ۴۴۳ منتشر نمی‌شود، و Alt-Svcی که به آن اشاره کند
	# فقط یک تلاشِ بی‌حاصلِ QUIC برای هر مرورگر است.
	servers {
		protocols h1 h2
	}
}

https:// {
	tls {
		on_demand
	}
	# پیش‌فرضِ `panel.invalid` فقط برای متغیرِ **نبوده** است؛ مقدارِ **خالی** را
	# compose با `${PANEL_DOMAIN:-panel.invalid}` می‌گیرد — Caddy با `host`ِ خالی
	# اصلاً بالا نمی‌آید (اجراشده: «module value cannot be null»).
	@panel host {$PANEL_DOMAIN:panel.invalid}
	handle @panel {
		reverse_proxy admin:8080
	}
	handle {
		reverse_proxy gateway:8080
	}
}
