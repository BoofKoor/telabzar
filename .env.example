# ── تل‌ابزار · نمونهٔ پیکربندی ──────────────────────────────────────────────
# این فایل **نمونه** است. فایلِ واقعیِ .env را `./install.sh` می‌سازد؛ دستی
# ویرایشش نکن مگر بدانی چه می‌کنی (`telabzar reconfigure` بازش می‌سازد).
#
# این‌جا فقط کلیدهایی هستند که یک استقرار از صفر باید یا معمولاً می‌خواهد ست
# کند. **همهٔ** کلیدها این‌جا نیستند و عمداً نیستند: منبعِ حقیقتْ فیلدهای
# `app/config.py:Settings` است (نامِ env = UPPER_SNAKE هر فیلد) و اکثرشان
# پیش‌فرضِ سالم دارند و از **پنلِ ادمین** زنده تنظیم می‌شوند
# (`settings_store.RUNTIME_KEYS`) — نه از این فایل و بدونِ ری‌استارت.

# ── الزامی ─────────────────────────────────────────────────────────────────
# تنها کلیدی که پیش‌فرض ندارد؛ بدونش هیچ پروسه‌ای بالا نمی‌آید.
BOT_TOKEN=123456:ABC-your-bot-token

# ── پایه (install.sh این‌ها را می‌پرسد) ────────────────────────────────────
# TG_API_ID/HASH را از my.telegram.org بگیر — سرورِ Bot APIِ محلی می‌خواهدشان
# (docker-compose.yml → TELEGRAM_API_ID/TELEGRAM_API_HASH).
TG_API_ID=0000000
TG_API_HASH=your_api_hash_from_my.telegram.org
ADMIN_IDS=111111111
DEFAULT_LANG=fa
MAX_FILE_MB=2000

# Postgres — این سه فقط توسطِ docker-compose مصرف می‌شوند (نه Settings).
# هشدار: رمز در ولومِ pg-data پخته می‌شود؛ عوض‌کردنش بعد از اولین بالا آمدن
# اتصالِ دیتابیس را می‌شکند (install.sh عمداً حفظش می‌کند).
POSTGRES_USER=telabzar
POSTGRES_PASSWORD=change-me-random
POSTGRES_DB=telabzar

# ── لینک و استریم (اختیاری؛ بدونِ آن دکمهٔ «لینک» غیرفعال است) ─────────────
# PUBLIC_BASE را install.sh از دامنه‌ای که می‌پرسد می‌سازد. خودِ DOMAIN عمداً
# در .env نوشته نمی‌شود چون هیچ کدی آن را نمی‌خواند.
PUBLIC_BASE=
GATEWAY_HTTPS_PORT=8443
TLS_CERT=
TLS_KEY=
# وقتی نودِ gateway زنده باشد، لینک‌ها به این دامنه اشاره می‌کنند (تنظیم‌شدنی
# از پنل). خالی = دامنهٔ خودِ مستر.
STREAM_BASE=

# ── پنلِ ادمین ─────────────────────────────────────────────────────────────
# ADMIN_SECRET کلیدِ Fernetِ کوکیِ نشست است. **خالی نگذارش در تولید** — با
# هر ری‌استارت نشست‌ها باطل می‌شوند.
ADMIN_SECRET=change-me-random-32-chars
ADMIN_BASE=
ADMIN_HTTPS_PORT=2083

# ── دانلود و خروجیِ شبکه ───────────────────────────────────────────────────
# PROXY_URL = خروجیِ تمیزِ تو. **امروز خالی است، یعنی egress مستقیم از IPِ
# مستر.** پیش از ست‌کردنش بولتِ «A hostname that isn't an IP literal…» در
# CLAUDE.md §۷ را بخوان: با پروکسیِ **داخلی**، fail-openِ شکستِ DNS باید
# برعکس شود. پروکسیِ socks از فاز ۳ت به موتورِ `direct` هم اعمال می‌شود
# (کلیدِ `dl_direct_proxy`, پیش‌فرض روشن)؛ `socks5h://` را خودمان به
# `socks5://` بازمی‌نویسیم چون python_socks اسکیمش را نمی‌شناسد و DNSِ
# سمتِ پروکسی همان‌جا پیش‌فرض است.
PROXY_URL=
# COOKIES_DIR عمداً این‌جا نیست: compose برای هر سرویسی که کوکی می‌خواند یا
# می‌نویسد `/cookies` را صریح ست می‌کند، و یک مقدارِ **خالی** در این فایل
# پیش‌فرضِ امنِ کد را باطل می‌کرد و کوکی را در CWDِ پروسه می‌نوشت.
POT_PROVIDER_URL=
COBALT_URL=
COBALT_API_KEY=

# ── اسپاتیفای (اختیاری — فقط متادیتا؛ دانلود از یوتیوب تطبیق داده می‌شود) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── نودها ──────────────────────────────────────────────────────────────────
# NODE_SECRET کلیدِ HMACِ توکنِ یک‌بارمصرفِ join است (خالی = fallback به
# BOT_TOKEN). بقیهٔ بلوکِ WG/NODE را **دستی ننویس**: `telabzar nodes-enable`
# (= node/master-setup.sh) کلیدِ WireGuard را می‌سازد، wg0 را بالا می‌آورد،
# IPِ عمومی را تشخیص می‌دهد و WG_MASTER_PUBKEY / WG_ENDPOINT / WG_MASTER_IP /
# WG_CONFIG_PATH و همهٔ NODE_* را خودش در .env می‌نویسد.
NODE_SECRET=

# روی خودِ **نود** (نه مستر) این‌ها را node/install.sh ست می‌کند، نه آدم:
#   NODE_ROLE  NODE_ID  NODE_NAME
